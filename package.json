{
  "name": "@local/qzone-diary",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "从机器人近期发言整理 QQ 空间日记草稿，并在启用后按计划发布。带设置页。",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.0"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["slots"]
    }
  }
}
