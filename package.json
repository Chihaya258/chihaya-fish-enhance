{
  "name": "chihaya-fish-enhance",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "QQ 机器人加强插件：QQ 空间随笔、主动回复与语音聊天（Breeze Blue 合成语音条）。带设置页。",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./tts": "./tts.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "tts.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "slots"
      ]
    }
  },
  "scripts": {
    "test": "node --test tts.test.js outgoing.test.js"
  }
}
